# Primary Domain and MX Host
PRIMARY_DOMAIN=example.com
MX_HOST=mail.example.com
DKIM_SELECTOR=mail

# Cloudflare API Token (Needs Zone:DNS:Edit permissions)
CF_API_TOKEN=your_cloudflare_api_token_here

# TLS for docker-mailserver: letsencrypt (default; needs a cert at /etc/letsencrypt/live/<MX_HOST>/),
# manual, self-signed, or empty for no TLS (local testing only)
# SSL_TYPE=letsencrypt

# Postmaster
POSTMASTER_ADDRESS=postmaster@example.com

# Custom project directory for Docker Mailserver data (defaults to current directory)
# DMS_PROJECT_DIR=/path/to/dms
