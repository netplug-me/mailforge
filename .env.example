# Primary Domain and MX Host
PRIMARY_DOMAIN=example.com
MX_HOST=mail.example.com
DKIM_SELECTOR=mail

# Cloudflare API Token (Needs Zone:DNS:Edit permissions)
CF_API_TOKEN=your_cloudflare_api_token_here

# TLS for docker-mailserver: letsencrypt (default; needs a cert at /etc/letsencrypt/live/<MX_HOST>/),
# manual, self-signed, or empty for no TLS (local testing only)
# SSL_TYPE=letsencrypt

# Postmark Server API Token (outbound relay, see outbound/compose.outbound.yaml)
# POSTMARK_SERVER_TOKEN=your_postmark_server_token_here

# Postmaster
POSTMASTER_ADDRESS=postmaster@example.com

# Custom project directory for Docker Mailserver data (defaults to current directory)
# DMS_PROJECT_DIR=/path/to/dms

# Cloudflare zones to hide from the TUI's Zones box (comma separated; display only, nothing is changed in Cloudflare)
# TUI_HIDE_ZONES=example.org,example.net

# Roundcube webmail (webmail/compose.webmail.yaml). Set to attach the service to compose commands.
# Needs a tunnel ingress rule and a Cloudflare Access policy for this hostname; see HAND_OFF.md.
# WEBMAIL_HOSTNAME=webmail.example.com
