{
  "name": "cf-mail-tui",
  "version": "1.0.0",
  "description": "Docker Mailserver Manager & Cloudflare DNS Sync with Interactive TUI",
  "type": "module",
  "bin": {
    "cf-mail": "./dist/index.js",
    "mailctl": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "node test/txt-upsert.test.mjs",
    "test:tui": "node test/tui-layout.test.mjs",
    "test": "npm run build && npm run test:unit && npm run test:ops && npm run test:tui",
    "test:ops": "node test/ops-parsers.test.mjs"
  },
  "keywords": [
    "docker-mailserver",
    "cloudflare",
    "dns",
    "tui",
    "email",
    "postfix",
    "opendkim"
  ],
  "author": "RCP Solutions",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.0",
    "string-width": "^8.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
